{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "additionalResources": {
            "type": "array"
        },
        "affinity": {
            "type": "object"
        },
        "apiUrl": {
            "type": "string"
        },
        "database": {
            "type": "object",
            "properties": {
                "engine": {
                    "type": "string",
                    "enum": [
                        "POSTGRES",
                        "MYSQL"
                    ]
                },
                "existingSecret": {
                    "type": "object",
                    "properties": {
                        "keys": {
                            "type": "object",
                            "properties": {
                                "database": {
                                    "type": "string"
                                },
                                "host": {
                                    "type": "string"
                                },
                                "password": {
                                    "type": "string"
                                },
                                "port": {
                                    "type": "string"
                                },
                                "username": {
                                    "type": "string"
                                }
                            }
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                },
                "params": {
                    "type": "string"
                }
            }
        },
        "env": {
            "type": "object"
        },
        "extraEnv": {
            "type": "array"
        },
        "extraEnvFrom": {
            "type": "array"
        },
        "extraVolumeMounts": {
            "type": "array"
        },
        "extraVolumes": {
            "type": "array"
        },
        "frontendUrl": {
            "type": "string"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "image": {
            "type": "object",
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "enum": [
                        "Always",
                        "IfNotPresent",
                        "Never"
                    ]
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": "array"
        },
        "ingress": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "backend": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        }
                    }
                },
                "className": {
                    "type": "string"
                },
                "enabled": {
                    "type": "boolean"
                },
                "extraHosts": {
                    "type": "array"
                },
                "frontend": {
                    "type": "object",
                    "properties": {
                        "host": {
                            "type": "string"
                        }
                    }
                },
                "tls": {
                    "type": "array"
                }
            }
        },
        "livenessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                },
                "periodSeconds": {
                    "type": "integer"
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object"
        },
        "oidcRedirectUrl": {
            "type": "string"
        },
        "podAnnotations": {
            "type": "object"
        },
        "podLabels": {
            "type": "object"
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "postgresql": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "settings": {
                    "type": "object",
                    "properties": {
                        "existingSecret": {
                            "type": "string"
                        },
                        "superuserPassword": {
                            "type": "object",
                            "properties": {
                                "secretKey": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "storage": {
                    "type": "object",
                    "properties": {
                        "requestedSize": {
                            "type": "string"
                        }
                    }
                },
                "userDatabase": {
                    "type": "object",
                    "properties": {
                        "existingSecret": {
                            "type": "string"
                        },
                        "name": {
                            "type": "object",
                            "properties": {
                                "secretKey": {
                                    "type": "string"
                                }
                            }
                        },
                        "password": {
                            "type": "object",
                            "properties": {
                                "secretKey": {
                                    "type": "string"
                                }
                            }
                        },
                        "user": {
                            "type": "object",
                            "properties": {
                                "secretKey": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "readinessProbe": {
            "type": "object",
            "properties": {
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                },
                "periodSeconds": {
                    "type": "integer"
                }
            }
        },
        "replicaCount": {
            "type": "integer"
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "secrets": {
            "type": "object",
            "properties": {
                "existingSecret": {
                    "type": "object",
                    "properties": {
                        "keys": {
                            "type": "object",
                            "properties": {
                                "bootstrapAdminPassword": {
                                    "type": "string"
                                },
                                "jwtSecret": {
                                    "type": "string"
                                },
                                "oidcClientSecret": {
                                    "type": "string"
                                },
                                "smtpPassword": {
                                    "type": "string"
                                }
                            }
                        },
                        "name": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "backendPort": {
                    "type": "integer"
                },
                "frontendPort": {
                    "type": "integer"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "ClusterIP",
                        "NodePort",
                        "LoadBalancer"
                    ]
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "properties": {
                "annotations": {
                    "type": "object"
                },
                "create": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                }
            }
        },
        "startupProbe": {
            "type": "object",
            "properties": {
                "failureThreshold": {
                    "type": "integer"
                },
                "httpGet": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "port": {
                            "type": "string"
                        }
                    }
                },
                "periodSeconds": {
                    "type": "integer"
                }
            }
        },
        "strictOrigins": {
            "type": "boolean"
        },
        "tolerations": {
            "type": "array"
        }
    }
}
